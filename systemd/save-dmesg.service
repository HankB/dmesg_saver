[Unit]
Description=Save dmesg output to writable storage
After=local-fs.target
RequiresMountsFor=/mnt/data
Before=umount.target

[Service]
Type=notify
NotifyAccess=all
User=root
ExecStart=/usr/local/bin/save-dmesg.sh /mnt/data
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target